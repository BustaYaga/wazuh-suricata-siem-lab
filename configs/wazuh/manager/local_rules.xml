<!-- Custom rules for the Wazuh + Suricata lab.
     Copy to /var/ossec/etc/rules/local_rules.xml on the manager, test with wazuh-logtest,
     then restart wazuh-manager. Rule IDs 100100+ are reserved for local rules. -->

<group name="local,suricata,">

  <rule id="100100" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">(?i)(ET SCAN|LAB Possible port scan)</field>
    <description>Network scan detected from $(src_ip)</description>
    <mitre><id>T1046</id></mitre>
  </rule>

  <rule id="100101" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">(?i)sql injection</field>
    <description>SQL injection attempt from $(src_ip) against $(dest_ip)</description>
    <mitre><id>T1190</id></mitre>
  </rule>

  <rule id="100102" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">(?i)(path traversal|directory traversal)</field>
    <description>Path traversal attempt from $(src_ip) against $(dest_ip)</description>
    <mitre><id>T1190</id></mitre>
  </rule>

</group>

<group name="local,windows,sysmon,">

  <rule id="100110" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-e(nc|ncodedcommand)?\s</field>
    <description>PowerShell started with an encoded command on $(win.system.computer)</description>
    <mitre><id>T1059.001</id></mitre>
  </rule>

  <rule id="100111" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(downloadstring|downloadfile|invoke-webrequest|iwr\s|curl\s)</field>
    <description>PowerShell downloading content on $(win.system.computer)</description>
    <mitre><id>T1105</id></mitre>
  </rule>

</group>

<group name="local,syscheck,">

  <rule id="100120" level="8">
    <if_sid>550,554</if_sid>
    <field name="file" type="pcre2">^/var/www/html/</field>
    <description>File added or changed in the web folder: $(file)</description>
    <mitre><id>T1565.001</id></mitre>
  </rule>

  <rule id="100121" level="12">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">^/etc/(passwd|shadow|sudoers)$</field>
    <description>Sensitive account file changed: $(file)</description>
    <mitre><id>T1098</id></mitre>
  </rule>

</group>
